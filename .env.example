# Security Alerting Tool - Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# =============================================================================
# ENCRYPTION (REQUIRED)
# =============================================================================
# Master key for AES-256-GCM encryption of API keys in database.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: Back up this key securely. If lost, encrypted API keys cannot be recovered.
MASTER_ENCRYPTION_KEY=

# =============================================================================
# EDR WEBHOOK SECRETS
# =============================================================================
# SentinelOne webhook secret (from S1 console webhook configuration)
S1_WEBHOOK_SECRET=

# CrowdStrike webhook secret (from Falcon console webhook configuration)
CS_WEBHOOK_SECRET=

# =============================================================================
# MICROSOFT TEAMS BOT (for action buttons)
# =============================================================================
# Azure Bot registration App ID
TEAMS_BOT_APP_ID=

# Azure Bot registration App Secret
TEAMS_BOT_APP_SECRET=

# =============================================================================
# OPTIONAL: Override config.yaml settings
# =============================================================================
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# LOG_LEVEL=INFO
